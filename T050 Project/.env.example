# Copy to backend/.env and adjust
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=contracts
POSTGRES_PASSWORD=contracts
POSTGRES_DB=contracts
DATABASE_URL=postgresql://contracts:contracts@localhost:5432/contracts
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
SECRET_KEY=change-me-in-production-please-use-a-real-secret-key-32chars
LLM_PROVIDER=heuristic
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=local-tfidf
EMBEDDING_DIM=384
