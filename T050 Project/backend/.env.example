# PostgreSQL + pgvector
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=contracts
POSTGRES_PASSWORD=contracts
POSTGRES_DB=contracts
DATABASE_URL=postgresql://contracts:contracts@postgres:5432/contracts

# Redis (Celery broker + cache)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage
# For S3-compatible (MinIO) set:
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY=minio
# S3_SECRET_KEY=minio123
# S3_BUCKET=contracts

# Security
SECRET_KEY=change-me-in-production-please-use-a-real-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM (optional - set to enable real LLM answers; otherwise deterministic fallback)
LLM_PROVIDER=heuristic
# LLM_PROVIDER=openai
# LLM_PROVIDER=azure
# LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_MODEL_ENDPOINT=

# Azure AI & Azure Document Intelligence Configuration
AZURE_AI_ENABLED=false
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-doc-intel-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-azure-key>
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout
AZURE_OPENAI_ENDPOINT=https://<your-azure-openai-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-azure-openai-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01-preview

# Embedding model
EMBEDDING_MODEL=local-tfidf
EMBEDDING_DIM=384

# AI risk scoring weights (sum = 1.0)
AI_RISK_RULE_WEIGHT=0.45
AI_RISK_NLP_WEIGHT=0.30
AI_RISK_LLM_WEIGHT=0.25

# Workflow
DEFAULT_SLA_HOURS=48

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

ENVIRONMENT=production
